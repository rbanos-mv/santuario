{
  "name": "@santuario/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "nx",
    "api": "nx serve api",
    "cloud": "nx serve cloud",
    "format": "prettier \"{src,apps,libs,test}/**/*.ts\" --write",
    "format:check": "prettier \"{src,apps,libs,test}/**/*.ts\" --check",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "nx test",
    "test:api": "nx test api",
    "test:api:cov": "nx test api --coverage",
    "test:api:watch": "nx test api --watch",
    "test:api:debug": "nx test api --debug",
    "test:cloud": "nx test cloud",
    "test:cloud:cov": "nx test cloud --coverage",
    "test:all": "nx run-many --target=test --all",
    "test:all:cov": "nx run-many --target=test --all --coverage",
    "test:affected": "nx affected:test",
    "test:affected:cov": "nx affected:test --coverage",
    "test:ci": "nx run-many --target=test --all --ci --coverage --watchAll=false",
    "test:clear": "nx reset",
    "test:watch": "nx test --watch",
    "test:cov": "nx test --coverage",
    "e2e": "nx e2e",
    "e2e:api": "nx e2e api-e2e",
    "e2e:cloud": "nx e2e cloud-e2e",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "21.5.3",
    "@nx/eslint-plugin": "21.5.3",
    "@nx/jest": "21.5.3",
    "@nx/js": "21.5.3",
    "@nx/nest": "21.5.3",
    "@nx/node": "21.5.3",
    "@nx/web": "21.5.3",
    "@nx/webpack": "21.5.3",
    "@nx/workspace": "21.5.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.0.0",
    "git-commit-msg-linter": "^5.0.8",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "lint-staged": "^16.2.0",
    "nodemon": "^3.1.10",
    "nx": "21.5.3",
    "prettier": "^2.8.8",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "author": "Roberto A. Baños Alvarez"
}
